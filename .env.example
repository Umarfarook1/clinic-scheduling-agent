# Copy to .env (never committed). Pick ONE provider.

# Default: AWS Bedrock with your normal AWS credentials (profile, SSO or env vars).
LLM_PROVIDER=bedrock
AWS_PROFILE=
AWS_REGION=eu-north-1

# Or the Anthropic API:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Or OpenAI / any OpenAI-compatible endpoint:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional per-role model overrides:
# AGENT_MODEL=  PATIENT_MODEL=  JUDGE_MODEL=  JUDGE2_MODEL=  IMPROVER_MODEL=
